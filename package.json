{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild server/vercel.ts --bundle --platform=node --format=esm --packages=external --target=node18 --outfile=api/index.js",
    "build:api": "esbuild server/vercel.ts --bundle --platform=node --format=esm --packages=external --target=node18 --outfile=api/index.js",
    "start": "node server.ts",
    "migrate:r2": "tsx scripts/migrate-to-r2.ts",
    "migrate:r2:dry-run": "tsx scripts/migrate-to-r2.ts --dry-run",
    "migrate:r2:verify": "tsx scripts/migrate-to-r2.ts --verify",
    "migrate:r2:rollback": "tsx scripts/migrate-to-r2.ts --rollback",
    "test:storage": "tsx scripts/test-r2-storage.ts",
    "test:acceptance": "tsx scripts/test-all-acceptance.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/blob": "^2.8.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
